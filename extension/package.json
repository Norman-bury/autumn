{
  "name": "autumn-extension",
  "version": "0.1.7",
  "description": "Browser extension for detecting and saving job listings to Autumn",
  "private": true,
  "type": "module",
  "packageManager": "yarn@4.12.0",
  "scripts": {
    "dev": "vite build --watch --mode development",
    "build": "vite build",
    "build:chrome": "vite build && cd dist && zip -r ../autumn-chrome.zip .",
    "build:firefox": "vite build && cd dist && zip -r ../autumn-firefox.zip .",
    "build:all": "yarn build:chrome && yarn build:firefox",
    "test": "vitest",
    "test:run": "vitest run",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "webextension-polyfill": "^0.12.0"
  },
  "devDependencies": {
    "@types/chrome": "^0.2.8",
    "@types/node": "^26.4.1",
    "@types/webextension-polyfill": "^0.12.6",
    "jsdom": "^30.0.1",
    "prettier": "^3.5.1",
    "sharp": "^0.35.4",
    "typescript": "^6.0.2",
    "vite": "^8.0.3",
    "vitest": "^5.0.0"
  }
}
